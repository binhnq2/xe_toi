<?xml version="1.0" encoding="utf-8"?>
<!--
  TS8 Lite — Home (design spec §5).

  Organic Maps is the content background: this layout draws only the thin top layer, the media row
  and the four-tab dock, and everything else is transparent so the map shows through.

  Deliberately absent: any connectivity, USB, BLE or ESP32 indicator. The spec puts those under
  Settings > Devices/Diagnostics only.
-->
<app.organicmaps.launcher.Ts8HomeLauncherView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/ts8_home_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/transparent"
  tools:background="@color/ts8_bg">

  <!-- ============ thin top layer: time / search / settings ============ -->
  <LinearLayout
    android:id="@+id/ts8_home_top_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ts8_top_bar_height"
    android:layout_gravity="top"
    android:layout_marginStart="@dimen/ts8_gap_l"
    android:layout_marginTop="@dimen/ts8_gap_s"
    android:layout_marginEnd="@dimen/ts8_gap_l"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/ts8_home_clock"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:textColor="@color/ts8_text_primary"
      android:textSize="@dimen/ts8_text_primary"
      tools:text="14:27" />

    <LinearLayout
      android:id="@+id/ts8_home_search"
      android:layout_width="0dp"
      android:layout_height="@dimen/ts8_search_pill_height"
      android:layout_marginStart="@dimen/ts8_gap_l"
      android:layout_marginEnd="@dimen/ts8_gap_l"
      android:layout_weight="1"
      android:background="@drawable/ts8_search_pill"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="@dimen/ts8_gap_m"
      android:paddingEnd="@dimen/ts8_gap_m">

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/ts8_search_hint"
        android:src="@android:drawable/ic_menu_search"
        app:tint="@color/ts8_text_secondary" />

      <TextView
        android:id="@+id/ts8_home_search_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ts8_gap_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/ts8_search_hint"
        android:textColor="@color/ts8_text_secondary"
        android:textSize="@dimen/ts8_text_secondary" />
    </LinearLayout>

    <ImageButton
      android:id="@+id/ts8_home_settings"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/ts8_settings"
      android:src="@android:drawable/ic_menu_preferences"
      app:tint="@color/ts8_text_primary" />
  </LinearLayout>

  <!-- ============ left shortcuts (hidden when navigation overlays need room) ============ -->
  <LinearLayout
    android:id="@+id/ts8_home_shortcuts"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_marginStart="@dimen/ts8_gap_l"
    android:layout_marginTop="72dp"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/ts8_shortcut_home"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:background="@drawable/ts8_round_surface"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/ts8_home_work"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="@color/ts8_text_primary" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/ts8_shortcut_favorites"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:layout_marginTop="@dimen/ts8_gap_s"
      android:background="@drawable/ts8_round_surface"
      android:clickable="true"
      android:contentDescription="@string/ts8_favorites"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/btn_star"
        app:tint="@color/ts8_text_primary" />
    </LinearLayout>
  </LinearLayout>

  <!-- ============ compact media row: directly above the dock ============ -->
  <LinearLayout
    android:id="@+id/ts8_media_row"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ts8_media_row_height"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/ts8_gap_l"
    android:layout_marginEnd="@dimen/ts8_gap_l"
    android:layout_marginBottom="@dimen/ts8_gap_s"
    android:layout_marginTop="0dp"
    android:background="@drawable/ts8_media_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ts8_gap_s"
    android:paddingEnd="@dimen/ts8_gap_s"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
      android:id="@+id/ts8_media_artwork"
      android:layout_width="@dimen/ts8_artwork_size"
      android:layout_height="@dimen/ts8_artwork_size"
      android:background="@drawable/ts8_round_surface"
      android:contentDescription="@string/ts8_now_playing"
      android:scaleType="centerCrop" />

    <TextView
      android:id="@+id/ts8_media_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/ts8_gap_m"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/ts8_text_primary"
      android:textSize="@dimen/ts8_text_secondary"
      tools:text="Chuyến đi" />

    <ImageButton
      android:id="@+id/ts8_media_prev"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/ts8_media_previous"
      android:src="@android:drawable/ic_media_previous"
      app:tint="@color/ts8_text_primary" />

    <ImageButton
      android:id="@+id/ts8_media_play_pause"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:background="@drawable/ts8_play_button"
      android:contentDescription="@string/ts8_media_play"
      android:src="@android:drawable/ic_media_play"
      app:tint="@color/ts8_text_primary" />

    <ImageButton
      android:id="@+id/ts8_media_next"
      android:layout_width="@dimen/ts8_touch_min"
      android:layout_height="@dimen/ts8_touch_min"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/ts8_media_next"
      android:src="@android:drawable/ic_media_next"
      app:tint="@color/ts8_text_primary" />
  </LinearLayout>

  <!-- ============ four-tab dock ============ -->
  <LinearLayout
    android:id="@+id/ts8_dock"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ts8_dock_height"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/ts8_gap_l"
    android:layout_marginEnd="@dimen/ts8_gap_l"
    android:layout_marginBottom="@dimen/ts8_gap_m"
    android:background="@drawable/ts8_dock_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/ts8_dock_map"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/ts8_dock_selected"
      android:clickable="true"
      android:contentDescription="@string/ts8_tab_map"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/ic_dialog_map"
        app:tint="@color/ts8_accent" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ts8_tab_map"
        android:textColor="@color/ts8_accent"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/ts8_dock_music"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:contentDescription="@string/ts8_tab_music"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/ts8_text_secondary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ts8_tab_music"
        android:textColor="@color/ts8_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/ts8_dock_assistant"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:contentDescription="@string/ts8_tab_assistant"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/ic_btn_speak_now"
        app:tint="@color/ts8_text_secondary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ts8_tab_assistant"
        android:textColor="@color/ts8_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/ts8_dock_apps"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:contentDescription="@string/ts8_tab_apps"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="@color/ts8_text_secondary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ts8_tab_apps"
        android:textColor="@color/ts8_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</app.organicmaps.launcher.Ts8HomeLauncherView>
